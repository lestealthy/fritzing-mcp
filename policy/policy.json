{
  "filesystem": {
    "controlled_root_only": true,
    "allow_arbitrary_paths": false,
    "allow_unc": false
  },
  "shell": {
    "enabled": false
  },
  "custom_parts": {
    "enabled": false
  },
  "community_parts": {
    "enabled": false
  },
  "overwrite": {
    "enabled": false
  },
  "network": {
    "enabled": false
  },
  "parts_search": {
    "max_limit": 50
  },
